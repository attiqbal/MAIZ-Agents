{
  "name": "MAIZ Agents",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "npm install && cd web && npm install",
  "postAttachCommand": "cd web && npm run dev",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Website (Vite)", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["dbaeumer.vscode-eslint"] }
  }
}
