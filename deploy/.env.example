# Copy to deploy/.env (git-ignored) and fill in. Also add every production variable from render.yaml that you use
# (SESSION_SECRET, TOKEN_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY, EMAIL_FROM, PLATFORM_OWNER_EMAILS, RUNPOD_*, ...).
DOMAIN=maizagents.com
APP_URL=https://maizagents.com
# Optional: search engine ownership codes (content of the meta tag only). Rebuild after setting.
# Google Search Console: HTML tag method. Bing Webmaster Tools: meta tag method.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SITE_URL=https://maizagents.com
# Contact address shown on the Terms and Privacy pages. Use an inbox someone reads (privacy requests go there). Rebuild after setting.
# The company name, number and registered office are fixed in src/company.ts.
CONTACT_EMAIL=
POSTGRES_PASSWORD=
APP_USER_PASSWORD=
# openssl rand -hex 32  (back it up off the server: losing it disconnects every customer's Slack and apps)
TOKEN_KEY=
SESSION_SECRET=
# Live replica on Oracle (docs/INTERIM-HOSTING.md). WG_ADDR is this server's WireGuard address.
REPLICA_PASSWORD=
WG_ADDR=10.10.0.1
# Empty = asynchronous (loses at most a second or two if Hetzner dies). 'ANY 1 (oracle)' = synchronous: no commit is
# acknowledged until Oracle has it (zero loss), but writes pause if Oracle is unreachable.
SYNC_STANDBY=
