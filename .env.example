# Copy to .env and fill in. Never commit real keys.
# Claude API key (console.anthropic.com). Required in production; without it in development employees give mock answers.
ANTHROPIC_API_KEY=

# --- API server (npm run dev:api) ---
# Required in production. Any long random string.
SESSION_SECRET=
# Development only: sign up by email with no verification. The server refuses to start in production with this on.
ALLOW_DEV_AUTH=
# Slack app (api.slack.com/apps). All four are needed to turn Slack on.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# --- Business apps (optional). Each pair turns on "Connect" for that app; without it the app falls back to file upload or Zapier.
# Redirect URI to register with each app: <APP_URL>/api/integrations/callback
# Xero: developer.xero.com/app/manage (granular scope accounting.reports.profitandloss.read)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Square: developer.squareup.com/apps (OAuth, scope PAYMENTS_READ). SQUARE_BASE_URL=https://connect.squareupsandbox.com for the sandbox.
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_BASE_URL=

# --- Storage (Postgres). Without DATABASE_URL the API keeps data in memory. Required in production. ---
# Platform role: creates customers, loads data at start (bypasses row-level security). Keep this secret and server-side only.
DATABASE_URL=
# Customer role app_user: every write runs inside one customer's workspace.
DATABASE_APP_URL=
# 64 hex characters (32 bytes) that encrypt chat bot tokens at rest. Generate: openssl rand -hex 32
TOKEN_KEY=

# --- Sign-in emails (Resend, resend.com). Without these, development prints the sign-in link in the API log. Required in production. ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, for example "MAIZ agents <hello@yourdomain.com>"
EMAIL_FROM=
# Public address of the website, used in sign-in links, for example https://app.yourdomain.com
APP_URL=

# --- AI ---
# Optional: override the default Claude model id used by the gateway.
ANTHROPIC_MODEL=

# --- Hosting ---
# Public address of the website at build time (canonical links, sitemap, Open Graph). Usually the same as APP_URL.
SITE_URL=
# Port to listen on. Hosts such as Render set this for you.
PORT=
# Set to 1 when behind a proxy that appends the client address to X-Forwarded-For (always on in production).
TRUST_PROXY=
# Optional: folder with the built website. Default web/dist. Leave empty to serve it from the same service.
WEB_DIST=
